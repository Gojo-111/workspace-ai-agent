# PostgreSQL connection string used by SQLAlchemy for the DB
DATABASE_URL=replace-with-the-string

# PostgreSQL connection string used by SQLAlchem for the test DB
TEST_DATABASE_URL=replace-with-the-string

# Secret used to protect server-side application sessions.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Base64-encoded encryption key used to encrypt Google OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-encryption-key

# Google OAuth 2.0 client ID for the Workspace AI Agent application.
GOOGLE_CLIENT_ID=your-google-client-id

# Google OAuth 2.0 client secret for the Workspace AI Agent application.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must exactly match a redirect URI registered in the Google Cloud Console
GOOGLE_REDIRECT_URI=your_redirect_url

# OpenAI API key used when AI_PROVIDER is set to openai.
OPENAI_API_KEY=your-openai-api-key

# Base URL of the local Ollama server used when AI_PROVIDER is set to ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Selects the active LLM provider: openai or ollama.
AI_PROVIDER=openai

# Exact Chrome extension origin allowed to make credentialed requests to the backend.
CORS_ALLOWED_ORIGIN=chrome-extension://your-extension-id
